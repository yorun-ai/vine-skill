domain greeting

@desc("Welcome data for the authenticated user")
pub data Welcome {
    username: string
    message: string
}

@desc("Welcome service; requires an authenticated actor (session)")
api service WelcomeApiService {
    for GreetingActor
    auth required
    @desc("Get welcome info; the actor is validated before this runs")
    method getWelcome {
        output Welcome
    }
}
